# =============================================================
# BlindTrack — variáveis de ambiente (EXEMPLO, valores fictícios)
# Copie para .env e troque TODOS os segredos:  cp .env.example .env
# =============================================================

# --- Aplicação ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Autenticação ---
# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# --- Uploads ---
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=10

# --- PostgreSQL (usado pelo docker-compose.yml) ---
# Porta 5433 no host para não conflitar com um PostgreSQL nativo na 5432.
POSTGRES_USER=blindtrack
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=blindtrack
POSTGRES_TEST_DB=blindtrack_test
POSTGRES_PORT=5433

# --- Prisma ---
DATABASE_URL=postgresql://blindtrack:troque-esta-senha@localhost:5433/blindtrack?schema=public
TEST_DATABASE_URL=postgresql://blindtrack:troque-esta-senha@localhost:5433/blindtrack_test?schema=public

# --- Seed (npm run db:seed) ---
# Senha inicial de TODOS os usuários criados pelo seed. Troque após o primeiro login.
SEED_SENHA_INICIAL=troque-esta-senha-inicial
# true = cria clientes, veículos e OS fictícios (ignorado em produção)
SEED_DADOS_EXEMPLO=true
